# Neon PostgreSQL connection string.
# Point this at your Neon "dev" branch locally; the production branch's
# connection string is set as DATABASE_URL in the deployment environment.
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# GitHub OAuth App credentials (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend (https://resend.com/api-keys) — used to send verification emails
RESEND_API_KEY=""
EMAIL_FROM="Synapse <onboarding@resend.dev>"

# Set to "false" to disable the email verification requirement (e.g. no domain
# linked to Resend yet, so only the Resend account's own email can receive mail).
# Any value other than "false" (including unset) keeps verification enabled.
EMAIL_VERIFICATION_ENABLED="true"

# Base URL used to build absolute links in emails (verification, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis (https://console.upstash.com) — used to rate limit auth endpoints.
# Rate limiting fails open (requests are allowed) if these are unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# CLOUDFLARE R2 STORAGE
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""